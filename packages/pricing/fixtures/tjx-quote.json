        "withoutMarkupTotal": "45.20"
      }
    },
    {
      "id": "tjx-f3-aggregate-ceiling",
      "note": "Legacy sums raw quantities across fixtures and ceils once; two 1.25 raw lines become 3.",
      "input": {
        "taxRate": "0.13",
        "fixtures": [
          { "quantity": "1", "parts": [{ "partNo": "WIN-300", "markup": "1", "ratioPerFixture": "1.25" }] },
          { "quantity": "1", "parts": [{ "partNo": "WIN-300", "markup": "1", "ratioPerFixture": "1.25" }] }
        ],
        "specialParts": [],
        "prices": { "WIN-300": "10.00" }
      },
      "expected": {
        "parts": [
          {
            "partNo": "WIN-300",
            "qtyWithMarkup": "3.000",
            "qtyWithoutMarkup": "2.500",
            "unitPrice": "10.00",
            "lineWithMarkup": "30.00",
            "lineWithoutMarkup": "25.00",
            "taxWithMarkup": "3.90",
            "taxWithoutMarkup": "3.25"
          }
        ],
        "subtotal": "30.00",
        "tax": "3.90",
        "total": "33.90",
        "withoutMarkupSubtotal": "25.00",
        "withoutMarkupTax": "3.25",
        "withoutMarkupTotal": "28.25"
      }
    },
