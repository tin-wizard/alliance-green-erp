{
  "cases": [
    {
      "id": "tjx-f1-basic",
      "note": "One line, no uplift.",
      "input": {
        "taxRate": "0.13",
        "fixtures": [
          { "quantity": "1", "parts": [{ "partNo": "WIN-100", "markup": "1", "ratioPerFixture": "1" }] }
        ],
        "specialParts": [],
        "prices": { "WIN-100": "10.00" }
      },
      "expected": {
        "parts": [
          {
            "partNo": "WIN-100",
            "qtyWithMarkup": "1.000",
            "qtyWithoutMarkup": "1.000",
            "unitPrice": "10.00",
            "lineWithMarkup": "10.00",
            "lineWithoutMarkup": "10.00",
            "taxWithMarkup": "1.30",
            "taxWithoutMarkup": "1.30"
          }
        ],
        "subtotal": "10.00",
        "tax": "1.30",
        "total": "11.30",
        "withoutMarkupSubtotal": "10.00",
        "withoutMarkupTax": "1.30",
        "withoutMarkupTotal": "11.30"
      }
    },
    {
