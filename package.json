{
  "name": "cls-green-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @cls/web dev",
    "build": "pnpm --filter @cls/web build",
    "start": "node scripts/start.mjs",
    "typecheck": "pnpm --filter @cls/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "db:generate": "pnpm --filter @cls/db generate",
    "db:generate:schema": "node scripts/generate-legacy-schema.mjs",
    "db:migrate": "pnpm --filter @cls/db migrate",
    "db:seed": "pnpm --filter @cls/db seed",
    "db:studio": "pnpm --filter @cls/db studio",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  }
}
