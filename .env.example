# ---------------------------------------------------------------------------
# CLS Green ERP - local server configuration
# Copy to .env and fill in. NEVER commit .env.
#
# Neon-provisioned projects can fill the Neon/AWS/AI block with:
#   neon env pull --file .env
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
# Bind 0.0.0.0 so other machines on the LAN can reach the server.
HOST=0.0.0.0
PORT=3000
# Public origin used for redirects and CSRF same-origin checks.
# Use the machine name or IP the browsers on the LAN actually type.
APP_URL=http://localhost:3000

# --- Database (Neon Postgres) ---------------------------------------------
# Pooled connection for the app. `neon env pull` provides both.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection. drizzle-kit and `pnpm db:migrate` use this.
DATABASE_URL_UNPOOLED=

# --- Neon Auth (Managed Better Auth) --------------------------------------
# Base URL from the Neon Console (Auth -> Configuration), e.g.
# https://ep-xxx.neonauth.c-1.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
# JWKS endpoint, normally <NEON_AUTH_BASE_URL>/.well-known/jwks.json
NEON_AUTH_JWKS_URL=

# --- App session cookie ----------------------------------------------------
# 32+ random bytes, base64. Signs/seals the app cookie only; passwords and
# JWTs are owned by Neon Auth.
SESSION_SECRET=replace-me-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
# Set true only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# --- Neon Object Storage (S3-compatible) ----------------------------------
# `neon env pull` writes the four AWS_* values for the linked branch.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
# auto = Neon storage when configured, otherwise local filesystem.
STORAGE_DRIVER=auto
# Operational files: WO photos, documents, compliance.
S3_BUCKET=assets
# Generated financial PDFs.
S3_ACCOUNTING_BUCKET=accounting
STORAGE_LOCAL_DIR=.data/storage

# --- Neon AI Gateway (provisioned, inference currently unfunded) -----------
AI_ENABLED=false
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
AI_DEFAULT_MODEL=claude-haiku-4-5

# --- Sage Business Cloud Accounting (REST v3.1) ---------------------------
# The developer app, subscription and OAuth consent belong to Alliance
# Lighting. Nothing here is a Sage 50 localhost key: those are retired and
# their presence fails startup by name.
SAGE_ENABLED=false
# Development only. Production refuses SAGE_FAKE=true.
SAGE_FAKE=false
SAGE_ENVIRONMENT=sandbox
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
# Must match the redirect URI registered on the developer app.
SAGE_REDIRECT_URI=http://localhost:3000/api/sage/oauth/callback
SAGE_API_BASE_URL=https://api.accounting.sage.com/v3.1
SAGE_AUTH_BASE_URL=https://www.sageone.com/oauth2/auth/central
SAGE_TOKEN_URL=https://oauth.accounting.sage.com/token
# Set after the callback if the tenant has more than one business.
SAGE_BUSINESS_ID=
# 32 bytes, base64 or 64 hex characters. Losing it means re-authorising.
SAGE_TOKEN_ENC_KEY=
SAGE_DAILY_QUOTA=2500
SAGE_MINUTE_QUOTA=100
# Tenant ledger accounts used by the payload mappers (optional until posting).
SAGE_SALES_ACCOUNT_ID=
SAGE_PURCHASE_ACCOUNT_ID=
SAGE_ROUNDING_ACCOUNT_ID=
# Shared secrets for the cron routes (x-cron-secret header). Generate with
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SAGE_CRON_SECRET=
JOB_RUNNER_SECRET=

# --- Bootstrap admin (used only by `pnpm db:seed`) -------------------------
# Leave blank for a normal install. Set a REAL address you control, and enable
# email verification in Neon Auth: the first verified sign-in with this address
# creates and links the admin row. A default address would be claimable by
# anyone who signs up with it.
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DISPLAY_NAME=Administrator

# --- Background jobs (ADR 0012) --------------------------------------------
# The in-process ticker is only for a long-lived Node host. A serverless deploy
# sets this to `off` and lets its platform cron call
# POST /api/internal/jobs/<key> with header `x-job-secret: JOB_RUNNER_SECRET`
# (declared with the cron secrets above; rotate it with the others).
JOBS_SCHEDULER=on
# Ticker interval. 60000 matches the ADR; anything under 5000 is ignored.
JOBS_TICK_MS=60000
# The scheduler lock is a session advisory lock, which does not survive
# PgBouncer-style transaction pooling. It is taken on DATABASE_URL_UNPOOLED
# (above) so "one environment runs the schedule" actually holds; that falls back
# to DATABASE_URL when unset, which is only correct for a direct Postgres.

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
