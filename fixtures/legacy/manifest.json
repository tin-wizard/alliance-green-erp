  "nastyCases": [
    {
      "case": "placeholder-work-order",
      "where": "workorder.id in (0, 9999998, 9999999, 44444444, 99999999)"
    },
    {
      "case": "duplicate-username",
      "where": "users.id in (1,2) both username jsmith"
    },
    {
      "case": "disabled-user",
      "where": "users.id in (3,4,5) is_enabled = 0"
    },
    {
      "case": "subcontractor-without-vendor",
      "where": "users.id = 6 subid = 99 has no subcontractor row"
    },
    {
      "case": "empty-email",
      "where": "users.id = 7 email = '' (empty string, not NULL)"
    },
    {
      "case": "shared-company-email",
      "where": "users.id in (8,9) both email info@clsgreen.com"
    },
    {
      "case": "orphan-workorder-site",
      "where": "workorder.id = 1003 customer = 7777 has no sites row"
    },
    {
      "case": "site-without-customer",
      "where": "workorder.id = 1004 site = 6 but customer = '' (empty string)"
    },
    {
      "case": "orphan-site-customer",
      "where": "sites.custid in (9001, 9002) have no customer row"
    },
    {
      "case": "orphan-work-order-line",
      "where": "wo_parts.woid in (88888881..88888884); inv_parts.woid = 88888881"
    },
    {
      "case": "unresolved-part-number",
      "where": "wo_parts.partno in ('---','--'); po_invoice_parts.partno = '---'"
    },
    {
      "case": "four-orphan-wo-parts",
      "where": "wo_parts ids 5-8 reference work orders that do not exist"
    },
    {
      "case": "work-order-id-in-three-columns",
      "where": "inv_tax.woid, inv_parts.applied_woid, inv_project.sage_project_workorder (the schema has woid plus the applied/project variants; no workorderid or wo_id column exists)"
    },
    {
      "case": "invoice-line-disagreement",
      "where": "inv_parts.id = 5 woid = 1005 but applied_woid = 99999999; inv_project id 2 sage_project_workorder 1003 differs from woid 1002"
    },
    {
      "case": "blank-money",
      "where": "inv_tax id 1 tax_amount; po_parts id 2 and id 10 price; po_invoice_parts id 2 price; po_invoice id 2 sub_total/total_amount"
    },
    {
      "case": "formatted-money",
      "where": "inv_tax id 2 ($13.00/$100.00); po_parts id 3 price '$1,234.50'; po_invoice id 3 sub_total '1,234.50'"
    },
    {
      "case": "non-numeric-money",
      "where": "inv_tax id 3 tax_amount 'n/a'; po_invoice_parts id 3 price 'n/a'; po_invoice id 4 total_amount 'n/a'"
    },
    {
      "case": "zero-money-owed",
      "where": "inv_tax id 4 tax_amount, subtotal_amount and total_amount all 0.00"
    },
    {
      "case": "qty-received-over-ordered",
      "where": "po_parts id 5 qty = 2.00 qty_received = 5.00"
    },
    {
      "case": "zero-date",
      "where": "workorder.id 0 datetaken/expcompletion, id 1006 datetaken/invdate; inv_hours id 4 date; po_invoice id 3 invoice_date; customer_quote id 4 date_created"
    },
    {
      "case": "empty-string-versus-null",
      "where": "workorder.notes (1002 empty, 1007 NULL); inv_project.sage_project_workorder (id 5 empty, id 3 NULL); po_invoice.sub_total (id 2 empty, id 4 NULL)"
    },
    {
      "case": "latin1-accents",
      "where": "customer.name id 3; sites.name/notes; workorder.servicerequired id 1005 and 1008; users.full_name id 10"
    },
    {
      "case": "embedded-newline",
      "where": "workorder.notes id 1005 (escaped \\n); sites.notes id 2 (escaped \\n)"
    },
    {
      "case": "escaped-quote-and-backslash",
      "where": "customer.name id 3 (L\\'Alliance) and id 5 (\\\"Centre\\\"); workorder.wo_folder_attach_path id 1001 (C:\\\\alliance)"
    },
    {
      "case": "hex-literal",
      "where": "wo_revisions.data_workorder revision_id 2 is 0xDEADBEEF (the legacy schema declares no BLOB column; wo_images_cropped holds only id, woid and cropped_time)"
    },
    {
      "case": "dated-duplicate-table",
      "where": "inv_parts_july_20_2025, parts_backup_17dec25, po_status_v2, workorder_backup_2025 each present with 1 row and absent from the load manifest"
    },
    {
      "case": "next-id-below-max-placeholder",
      "where": "wo_next_pid.next_id = 10010 while workorder carries 99999999"
    }
